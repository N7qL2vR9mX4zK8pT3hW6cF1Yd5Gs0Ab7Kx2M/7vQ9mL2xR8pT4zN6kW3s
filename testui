	fk, fl, fm = fk / 255, fl / 255, fm / 255
	local ft, fu = math.ft(fk, fl, fm), math.fu(fk, fl, fm)
	local fv, fw, fx
	fx = ft

	local fy = ft - fu
	if ft == 0 then
		fw = 0
