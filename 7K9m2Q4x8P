	if not hb then
		hb = k.l.CharacterAdded:Wait()
	end
	return hb
end

local function hc(hd)
	return hd
		and hd.Character
		and hd.Character:FindFirstChild("HumanoidRootPart")
		and hd.Character:FindFirstChild("Humanoid")
		and hd.Character.Humanoid.Health > 0
end

local function he()
	local hf = k.l:FindFirstChild("petsFolder")
	if not hf then return end
	for _, hg in pairs(hf:GetChildren()) do
		if hg:IsA("Folder") then
			for _, hh in pairs(hg:GetChildren()) do
				pcall(function()
					a.c.rEvents.equipPetEvent:FireServer("unequipPet", hh)
				end)
			end
		end
	end
end

local function hi(hj, hk)
	he()
	local hl = k.l.petsFolder and k.l.petsFolder:FindFirstChild("Unique")
	if not hl then return end
	local hm = 0
	hk = hk or 8
	for _, hn in pairs(hl:GetChildren()) do
		if hn.Name == hj and hm < hk then
			pcall(function()
				a.c.rEvents.equipPetEvent:FireServer("equipPet", hn)
			end)
			hm += 1
		end
	end
end

local function ho()
	local hp = k.l.Character
	if not hp then return end
	local hq = hp:FindFirstChildOfClass("Humanoid")
	if not hq then return end
	for _, hr in pairs(k.l.Backpack:GetChildren()) do
		if hr.Name == "Punch" then
			hq:EquipTool(hr)
			break
		end
	end
	local hs = k.l:FindFirstChild("muscleEvent")
	if hs then
		hs:FireServer("punch", "leftHand")
		hs:FireServer("punch", "rightHand")
	end
end

local function ht(hu)
	if not hc(hu) then return end
	local hv = ha()
	local hw = hv and hv:FindFirstChild("LeftHand")
	if not hw then return end
	pcall(function()
		firetouchinterest(hu.Character.HumanoidRootPart, hw, 0)
		firetouchinterest(hu.Character.HumanoidRootPart, hw, 1)
		ho()
	end)
end

local function hx(hy)
	if not hy then return 0 end
	local hz = hy:FindFirstChild("Durability")
		or (hy:FindFirstChild("leaderstats") and hy.leaderstats:FindFirstChild("Durability"))
	if not hz then return 0 end
	local ia = 1
	local ib = hy:FindFirstChild("ultimatesFolder")
	if ib and ib:FindFirstChild("Infernal Health") then
		ia += 0.15 * (ib["Infernal Health"].Value or 0)
	end
	local ic = hy:FindFirstChild("equippedPets")
	if ic then
		for _, id in ipairs(ic:GetChildren()) do
			if id:IsA("ObjectValue") and id.Value then
				local ie = string.lower(id.Value.Name)
				if ie:find("mighty") and ie:find("monster") then ia += 0.5 end
				if ie:find("small") and ie:find("fry") then ia += 0.25 end
			end
		end
	end
	return hz.Value * ia
end

local function if_(ig)
	if not ig or not ig:FindFirstChild("leaderstats") or not ig.leaderstats:FindFirstChild("Strength") then
		return 0
	end
	local ih = ig.leaderstats.Strength.Value * (1 / 15)
	local ii = 1
	local ij = ig:FindFirstChild("ultimatesFolder")
	if ij and ij:FindFirstChild("Demon Damage") then
		ii += 0.1 * (ij["Demon Damage"].Value or 0)
	end
	local ik = ig:FindFirstChild("equippedPets")
	if ik then
		for _, il in ipairs(ik:GetChildren()) do
			if il:IsA("ObjectValue") and il.Value then
				local im = string.lower(il.Value.Name)
				if im:find("wild") and im:find("wizard") then ii += 0.5 end
				if im:find("chaos") and im:find("sorcerer") then ii += 0.25 end
			end
		end
	end
	return ih * ii
end

