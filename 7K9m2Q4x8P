local antiFlingState = { enabled = false }

local function findAntiFlingVelocity(root)
	local bv = root:FindFirstChild("BodyVelocity")
	if bv and bv.MaxForce == Vector3.new(100000, 0, 100000) then
		return bv
	end
	return nil
end

local function enableAntiFling()
	if not antiFlingState.enabled or not PlayerData.LocalPlayer.Character then return end
	local root = PlayerData.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local existing = findAntiFlingVelocity(root)
	if existing then existing:Destroy() end

	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(100000, 0, 100000)
	bv.Velocity = Vector3.new(0, 0, 0)
	bv.P = 1250
	bv.Parent = root
end

local function disableAntiFling()
	if not PlayerData.LocalPlayer.Character then return end
	local root = PlayerData.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local existing = findAntiFlingVelocity(root)
	if existing then existing:Destroy() end
end

tabs.Misc:addToggle("Anti Fling", function(enabled)
	antiFlingState.enabled = enabled
	if enabled then
		enableAntiFling()
	else
		disableAntiFling()
	end
end)

