	Blacklist = "b.txt",
	Watchlist = "c.txt"
}

local function saveList(filename, list)
	writefile(filename, table.concat(list, "\n"))
end

local function loadList(filename)
	local result = {}
	if isfile(filename) then
		for line in readfile(filename):gmatch("[^\r\n]+") do
			local trimmed = line:match("^%s*(.-)%s*$")
			if trimmed and trimmed ~= "" then
				table.insert(result, trimmed)
			end
		end
	end
	return result
end

