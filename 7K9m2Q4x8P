local function getEffectiveHealth(player)
	if not player then return 0 end
	local durability = player:FindFirstChild("Durability")
		or (player:FindFirstChild("leaderstats") and player.leaderstats:FindFirstChild("Durability"))
	if not durability then return 0 end
	local multiplier = 1
	local ultimates = player:FindFirstChild("ultimatesFolder")
	if ultimates and ultimates:FindFirstChild("Infernal Health") then
		multiplier += 0.15 * (ultimates["Infernal Health"].Value or 0)
	end
	local equippedPets = player:FindFirstChild("equippedPets")
	if equippedPets then
		for _, petValue in ipairs(equippedPets:GetChildren()) do
			if petValue:IsA("ObjectValue") and petValue.Value then
				local name = string.lower(petValue.Value.Name)
				if name:find("mighty") and name:find("monster") then multiplier += 0.5 end
				if name:find("small") and name:find("fry") then multiplier += 0.25 end
			end
		end
	end
	return durability.Value * multiplier
end

local function getEffectiveDamage(player)
	if not player or not player:FindFirstChild("leaderstats") or not player.leaderstats:FindFirstChild("Strength") then
		return 0
	end
	local base = player.leaderstats.Strength.Value * (1 / 15)
	local multiplier = 1
	local ultimates = player:FindFirstChild("ultimatesFolder")
	if ultimates and ultimates:FindFirstChild("Demon Damage") then
		multiplier += 0.1 * (ultimates["Demon Damage"].Value or 0)
	end
	local equippedPets = player:FindFirstChild("equippedPets")
	if equippedPets then
		for _, petValue in ipairs(equippedPets:GetChildren()) do
			if petValue:IsA("ObjectValue") and petValue.Value then
				local name = string.lower(petValue.Value.Name)
				if name:find("wild") and name:find("wizard") then multiplier += 0.5 end
				if name:find("chaos") and name:find("sorcerer") then multiplier += 0.25 end
			end
		end
	end
	return base * multiplier
end

