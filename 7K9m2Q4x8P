function br.cf(cg)
	cg = math.max(0, math.floor(cg))
	local ch = math.floor(cg / 86400)
	local ci = math.floor((cg % 86400) / 3600)
	local cj = math.floor((cg % 3600) / 60)
	local ck = cg % 60
	return string.format("%dD / %dH / %dM / %dS", ch, ci, cj, ck)
end

function br.cl(cm)
	local cn = cm < 0
	cm = math.abs(cm)
	local co = {
		{1e18, "Qi"},
		{1e15, "Qa"},
		{1e12, "T"},
		{1e9, "B"},
		{1e6, "M"}
	}
	for _, cp in ipairs(co) do
		local cq, cr = cp[1], cp[2]
		if cm >= cq then
			local cs = cm / cq
			if cr == "Qi" or cr == "Qa" then
				return (cn and "-" or "") .. string.format("%.2f%s", cs, cr)
			else
				return (cn and "-" or "") .. string.format("%.1f%s", cs, cr)
			end
		end
	end
	return (cn and "-" or "") .. string.format("%.0f", cm)
end

