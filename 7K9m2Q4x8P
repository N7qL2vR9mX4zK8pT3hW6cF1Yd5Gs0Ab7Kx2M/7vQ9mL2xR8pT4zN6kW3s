local function li(lj, lk)
	kw.ky = lj
	kw.kz = lk
	if kw.kx then
		kw.kx:Disconnect()
		kw.kx = nil
	end
	if kw.ld then
		kw.ld:Disconnect()
		kw.ld = nil
	end
	kw.lc = nil
	local ll = 0
	kw.kx = a.d.Heartbeat:Connect(function()
		if not kw.ky then return end
		ll += 1
		if ll < 3 then return end
		ll = 0
		if kw.ky == "pack" then
			le()
		elseif kw.ky == "hp" then
			lg()
		end
		if kw.kz == "tp" then
			local lm = ha() and ha():FindFirstChild("HumanoidRootPart")
			if not lm then return end
			for _, ln in ipairs(_G.kc) do
				local lo
				for _, lp in ipairs(a.b:GetPlayers()) do
					if lp.Name:lower() == ln:lower() then
						lo = lp
						break
					end
				end
				if lo and hc(lo) then
					if kw.lc ~= lo then
						if kw.ld then
							kw.ld:Disconnect()
							kw.ld = nil
						end
						kw.lc = lo
						local lq = lm.CFrame
						lm.CFrame = lo.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2)
						ho()
						local lr = lo.Character:FindFirstChildOfClass("Humanoid")
						if lr then
							kw.ld = lr.Died:Once(function()
								task.wait(0.01)
								if lm and lm.Parent then
									lm.CFrame = lq
								end
								kw.lc = nil
							end)
						end
					else
						lm.CFrame = lo.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2)
						ho()
					end
					break
				end
			end
		elseif kw.kz == "blacklist" then
			for _, ls in ipairs(a.b:GetPlayers()) do
				if ls ~= k.l and km(ls) then
					ht(ls)
				end
			end
		elseif kw.kz == "watchlist" then
			for _, lt in ipairs(a.b:GetPlayers()) do
				if lt ~= k.l and ko(lt) and hc(lt) then
					ht(lt)
				end
			end
		end
	end)
end

