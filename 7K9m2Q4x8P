local nameLabel = tabs.Stats:addLabel("Name: ")
local strengthLabel = tabs.Stats:addLabel("Strength: ")
local durabilityLabel = tabs.Stats:addLabel("Durability: ")
local enemyHealthLabel = tabs.Stats:addLabel("Enemy Health: ")
local enemyDamageLabel = tabs.Stats:addLabel("Enemy Damage: ")
local yourHealthLabel = tabs.Stats:addLabel("Your Health: ")
local yourDamageLabel = tabs.Stats:addLabel("Your Damage: ")
local hitsToKillLabel = tabs.Stats:addLabel("Hits To Kill: ")

local function updateBasicStats(player)
	if not player then return end
	nameLabel.Text = "Name: " .. player.DisplayName
	if not player:FindFirstChild("leaderstats") then return end

	local function setStat(label, prefix, statName)
		local stat = player.leaderstats:FindFirstChild(statName) or player:FindFirstChild(statName)
		label.Text = stat and string.format("%s: %s", prefix, Utils.formatNumber(stat.Value)) or (prefix .. ": 0")
	end
	setStat(strengthLabel, "Strength", "Strength")
	setStat(durabilityLabel, "Durability", "Durability")
end

local function updateCombatStats(player)
	if not player then
		enemyHealthLabel.Text = "Enemy Health: "
		enemyDamageLabel.Text = "Enemy Damage: "
		yourHealthLabel.Text = "Your Health: "
		yourDamageLabel.Text = "Your Damage: "
		hitsToKillLabel.Text = "Hits To Kill: "
		return
	end

	local enemyHealth = getEffectiveHealth(player)
	local enemyDamage = getEffectiveDamage(player)
	local yourHealth = getEffectiveHealth(PlayerData.LocalPlayer)
	local yourDamage = getEffectiveDamage(PlayerData.LocalPlayer)

	local hitsText = "inf"
	if yourDamage > 0 then
		local hits = math.ceil(enemyHealth / yourDamage)
		if hits > 200 then
			hitsText = "inf"
		elseif hits < 1 then
			hitsText = "instant"
		else
			hitsText = tostring(hits)
		end
	end

	enemyHealthLabel.Text = "Enemy Health: " .. Utils.formatNumber(enemyHealth)
	enemyDamageLabel.Text = "Enemy Damage: " .. Utils.formatNumber(enemyDamage)
	yourHealthLabel.Text = "Your Health: " .. Utils.formatNumber(yourHealth)
	yourDamageLabel.Text = "Your Damage: " .. Utils.formatNumber(yourDamage)
	hitsToKillLabel.Text = "Hits To Kill: " .. hitsText
end

task.spawn(function()
	while true do
		if selectedStatsPlayer then
			updateBasicStats(selectedStatsPlayer)
			updateCombatStats(selectedStatsPlayer)
		end
