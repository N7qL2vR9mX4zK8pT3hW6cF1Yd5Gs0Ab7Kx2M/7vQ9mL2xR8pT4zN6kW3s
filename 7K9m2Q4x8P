local function equipPetsByName(petName, maxCount)
	unequipAllPets()
	local uniqueFolder = PlayerData.LocalPlayer.petsFolder and PlayerData.LocalPlayer.petsFolder:FindFirstChild("Unique")
	if not uniqueFolder then return end
	local equipped = 0
	maxCount = maxCount or 8
	for _, pet in pairs(uniqueFolder:GetChildren()) do
		if pet.Name == petName and equipped < maxCount then
			pcall(function()
				Services.ReplicatedStorage.rEvents.equipPetEvent:FireServer("equipPet", pet)
			end)
			equipped += 1
		end
	end
end

