	diedConnection = nil
}

local function switchPackPets()
	local now = tick()
	if now - killState.lastPetSwitch < 0.2 then return end
	killState.lastPetSwitch = now
	if killState.petToggle == 0 then
		equipPetsByName("Wild Wizard")
		killState.petToggle = 1
	else
		equipPetsByName("Mighty Monster")
		killState.petToggle = 0
	end
end

local function forceMightyMonster()
	local now = tick()
	if now - killState.lastPetSwitch < 0.2 then return end
	killState.lastPetSwitch = now
	equipPetsByName("Mighty Monster")
end

local function startKillLoop(mode, targetMode)
	killState.mode = mode
	killState.targetMode = targetMode
	if killState.connection then
		killState.connection:Disconnect()
		killState.connection = nil
	end
	if killState.diedConnection then
		killState.diedConnection:Disconnect()
		killState.diedConnection = nil
	end
	killState.currentTarget = nil
	local frameSkip = 0
	killState.connection = Services.RunService.Heartbeat:Connect(function()
		if not killState.mode then return end
		frameSkip += 1
		if frameSkip < 3 then return end
		frameSkip = 0
		if killState.mode == "pack" then
			switchPackPets()
		elseif killState.mode == "hp" then
			forceMightyMonster()
		end
		if killState.targetMode == "tp" then
			local root = getCharacter() and getCharacter():FindFirstChild("HumanoidRootPart")
			if not root then return end
			for _, name in ipairs(_G.tpList) do
				local target
				for _, player in ipairs(Services.Players:GetPlayers()) do
					if player.Name:lower() == name:lower() then
						target = player
						break
					end
				end
				if target and isAlive(target) then
					if killState.currentTarget ~= target then
						if killState.diedConnection then
							killState.diedConnection:Disconnect()
							killState.diedConnection = nil
						end
						killState.currentTarget = target
						local originalCFrame = root.CFrame
						root.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2)
						doPunch()
						local humanoid = target.Character:FindFirstChildOfClass("Humanoid")
						if humanoid then
							killState.diedConnection = humanoid.Died:Once(function()
								task.wait(0.01)
								if root and root.Parent then
									root.CFrame = originalCFrame
								end
								killState.currentTarget = nil
							end)
						end
					else
						root.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2)
						doPunch()
					end
					break
				end
			end
		elseif killState.targetMode == "blacklist" then
			for _, player in ipairs(Services.Players:GetPlayers()) do
				if player ~= PlayerData.LocalPlayer and isOnBlacklist(player) then
					touchKill(player)
				end
			end
		elseif killState.targetMode == "watchlist" then
			for _, player in ipairs(Services.Players:GetPlayers()) do
				if player ~= PlayerData.LocalPlayer and isOnWatchlist(player) and isAlive(player) then
					touchKill(player)
				end
			end
		end
	end)
end

local function stopKillLoop()
	killState.mode = nil
	killState.targetMode = nil
	if killState.connection then
		killState.connection:Disconnect()
		killState.connection = nil
	end
	if killState.diedConnection then
		killState.diedConnection:Disconnect()
		killState.diedConnection = nil
	end
	killState.currentTarget = nil
end

local function addKillToggle(tab, label, mode, targetMode)
	tab:addToggle(label, function(enabled)
		if enabled then
			startKillLoop(mode, targetMode)
		elseif killState.targetMode == targetMode and killState.mode == mode then
			stopKillLoop()
		end
	end)
end

