local function ju(jv, jw)
	writefile(jv, table.concat(jw, "\n"))
end

local function jx(jy)
	local jz = {}
	if isfile(jy) then
		for ka in readfile(jy):gmatch("[^\r\n]+") do
			local kb = ka:match("^%s*(.-)%s*$")
			if kb and kb ~= "" then
				table.insert(jz, kb)
			end
		end
	end
	return jz
end

