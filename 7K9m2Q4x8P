function Window:addTab(name)
	local index = #self.tabs + 1
	local button = Utils.create("TextButton", {
		Parent = self.tabList,
		Size = UDim2.new(1, -8, 0, 32),
		BackgroundColor3 = Theme.Button,
		BackgroundTransparency = 1,
		Text = "  " .. name,
		TextColor3 = Theme.TextDim,
		Font = Theme.Font,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		AutoButtonColor = false,
		BorderSizePixel = 0
	})
	Utils.addCorner(button, 8)
	button.MouseEnter:Connect(function()
		if button.BackgroundTransparency == 1 then
			Services.TweenService:Create(button, TweenInfo.new(0.12), {
				BackgroundTransparency = 0.35,
				BackgroundColor3 = Theme.ButtonHover
			}):Play()
		end
	end)
	button.MouseLeave:Connect(function()
		if button.TextColor3 ~= Theme.TextBright then
			Services.TweenService:Create(button, TweenInfo.new(0.12), {
				BackgroundTransparency = 1
			}):Play()
		end
	end)
	local page = Utils.create("Frame", {
		Parent = self.contentArea,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = index == 1,
		BorderSizePixel = 0
	})
	local leftColumn = Utils.create("ScrollingFrame", {
		Parent = page,
		Size = UDim2.new(Layout.ContentSplit, -8, 1, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Accent,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		BorderSizePixel = 0
	})
	Utils.create("UIListLayout", {Parent = leftColumn, Padding = UDim.new(0, 7)})
	Utils.create("UIPadding", {
		Parent = leftColumn,
		PaddingTop = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 6)
	})
	local rightColumn = Utils.create("ScrollingFrame", {
		Parent = page,
		Size = UDim2.new(1 - Layout.ContentSplit, -8, 1, 0),
		Position = UDim2.new(Layout.ContentSplit, 8, 0, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Accent,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		BorderSizePixel = 0
	})
	Utils.create("UIListLayout", {Parent = rightColumn, Padding = UDim.new(0, 7)})
	Utils.create("UIPadding", {
		Parent = rightColumn,
		PaddingTop = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 10)
	})
	if self.onDragStart then
		for _, frame in ipairs({leftColumn, rightColumn, page}) do
			frame.InputBegan:Connect(self.onDragStart)
			frame.InputEnded:Connect(self.onDragEnd)
		end
	end
	table.insert(self.tabs, {Button = button, Page = page})
	table.insert(self.tabPositions, 10 + (index - 1) * 37)
	button.MouseButton1Click:Connect(function()
		self:selectTab(index)
	end)
	return setmetatable({
		left = leftColumn,
		right = rightColumn,
		page = page,
		window = self
	}, Tab)
end

function Window:selectTab(index)
	self.selectedIndex = index
	for i, tab in ipairs(self.tabs) do
		tab.Page.Visible = (i == index)
		if i == index then
			Services.TweenService:Create(tab.Button, TweenInfo.new(0.15), {
				BackgroundTransparency = 0.22,
				BackgroundColor3 = Theme.Selected,
				TextColor3 = Theme.TextBright
			}):Play()
		else
			Services.TweenService:Create(tab.Button, TweenInfo.new(0.15), {
				BackgroundTransparency = 1,
				TextColor3 = Theme.TextDim
			}):Play()
		end
	end
	Services.TweenService:Create(self.indicator, TweenInfo.new(0.18), {
		Position = UDim2.fromOffset(0, self.tabPositions[index] or 10)
	}):Play()
end

