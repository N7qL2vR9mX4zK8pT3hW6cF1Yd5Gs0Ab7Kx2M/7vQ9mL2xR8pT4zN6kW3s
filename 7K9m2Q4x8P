local function pj(pk)
	if not pk then return end
	pb.Text = "Name: " .. pk.DisplayName
	if not pk:FindFirstChild("leaderstats") then return end
	local function pl(pm, pn, po)
		local pp = pk.leaderstats:FindFirstChild(po) or pk:FindFirstChild(po)
		pm.Text = pp and string.format("%s: %s", pn, br.cl(pp.Value)) or (pn .. ": 0")
	end
	pl(pc, "Strength", "Strength")
	pl(pd, "Durability", "Durability")
end

local function pq(pr)
	if not pr then
		pe.Text = "Enemy Health: "
		pf.Text = "Enemy Damage: "
		pg.Text = "Your Health: "
		ph.Text = "Your Damage: "
		pi.Text = "Hits To Kill: "
		return
	end
	local ps = hx(pr)
	local pt = if_(pr)
	local pu = hx(k.l)
	local pv = if_(k.l)
	local pw = "inf"
	if pv > 0 then
		local px = math.ceil(ps / pv)
		if px > 200 then pw = "inf"
		elseif px < 1 then pw = "instant"
		else pw = tostring(px) end
	end
	pe.Text = "Enemy Health: " .. br.cl(ps)
	pf.Text = "Enemy Damage: " .. br.cl(pt)
	pg.Text = "Your Health: " .. br.cl(pu)
	ph.Text = "Your Damage: " .. br.cl(pv)
	pi.Text = "Hits To Kill: " .. pw
end

