	local startTime = os.clock()
	local accumulator = 0
	Services.RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 1 then
			accumulator -= 1
			uptimeLabel.Text = Utils.formatTime(os.clock() - startTime)
		end
	end)
	local resizeHandle = Utils.create("TextButton", {
		Parent = mainFrame,
		Size = UDim2.fromOffset(18, 18),
		Position = UDim2.new(1, -18, 1, -18),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 10,
		AutoButtonColor = false
	})
	local isVisible = true
	toggleButton.MouseButton1Click:Connect(function()
		if toggleMoved then return end
		isVisible = not isVisible
		mainFrame.Visible = isVisible
	end)
	local isDraggingWindow, dragStart, windowStart = false, nil, nil
	local isResizing, resizeStart, sizeStart = false, nil, nil
	local function onDragStart(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDraggingWindow = true
			dragStart = input.Position
			windowStart = mainFrame.Position
		end
	end
	local function onDragEnd(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDraggingWindow = false
		end
	end
	for _, element in ipairs({header, sidebar, tabList, contentArea, footer, statusBar}) do
		element.InputBegan:Connect(onDragStart)
		element.InputEnded:Connect(onDragEnd)
	end
	resizeHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isResizing = true
			resizeStart = input.Position
			sizeStart = mainFrame.Size
		end
	end)
	resizeHandle.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isResizing = false
		end
	end)
	Services.UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end

		if isDraggingWindow then
			local delta = input.Position - dragStart
			mainFrame.Position = UDim2.new(
				windowStart.X.Scale, windowStart.X.Offset + delta.X,
				windowStart.Y.Scale, windowStart.Y.Offset + delta.Y
			)
		elseif isResizing then
			local delta = input.Position - resizeStart
			mainFrame.Size = UDim2.new(
				sizeStart.X.Scale, math.max(Layout.MinWidth, sizeStart.X.Offset + delta.X),
				sizeStart.Y.Scale, math.max(Layout.MinHeight, sizeStart.Y.Offset + delta.Y)
			)
		elseif isDraggingToggle then
			local delta = input.Position - toggleStartInput
			if math.abs(delta.X) > 3 or math.abs(delta.Y) > 3 then
				toggleMoved = true
			end
			toggleButton.Position = UDim2.new(
				toggleStartPos.X.Scale, toggleStartPos.X.Offset + delta.X,
				toggleStartPos.Y.Scale, toggleStartPos.Y.Offset + delta.Y
			)
		end
	end)
	self.onDragStart = onDragStart
	self.onDragEnd = onDragEnd
	return self
end

