local function stopSpectate()
	if spectateState.characterConnection then
		spectateState.characterConnection:Disconnect()
		spectateState.characterConnection = nil
	end
	spectateState.cameraLoop = false
	if PlayerData.LocalPlayer.Character then
		local humanoid = PlayerData.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			PlayerData.Camera.CameraSubject = humanoid
			PlayerData.Camera.CameraType = Enum.CameraType.Custom
		end
	end
	spectateState.active = false
	spectateState.target = nil
	getgenv().spectatePersist.active = false
	stopEsp()
end

local function maintainCamera()
	if spectateState.cameraLoop then
		spectateState.cameraLoop = false
		task.wait(0.01)
	end
	spectateState.cameraLoop = true
	task.spawn(function()
		while spectateState.cameraLoop do
			task.wait(0.01)
			if spectateState.active and spectateState.target then
				local character = spectateState.target.Character
				if character then
					local humanoid = character:FindFirstChildOfClass("Humanoid")
					if humanoid and PlayerData.Camera.CameraSubject ~= humanoid then
						PlayerData.Camera.CameraSubject = humanoid
					end
				end
			else
				break
			end
		end
	end)
end

local function setSpectateTarget(player)
	if not player then
		if spectateState.userId then
			for _, p in ipairs(Services.Players:GetPlayers()) do
				if p.UserId == spectateState.userId then
					player = p
					spectateState.target = player
					break
				end
			end
		end
		if not player and getgenv().spectatePersist.userId then
			for _, p in ipairs(Services.Players:GetPlayers()) do
				if p.UserId == getgenv().spectatePersist.userId then
					player = p
					spectateState.target = player
					spectateState.userId = p.UserId
					break
				end
			end
		end
		if not player then
			stopSpectate()
			return
		end
	end
	spectateState.userId = player.UserId
	spectateState.target = player
	getgenv().spectatePersist.userId = player.UserId
	if spectateState.characterConnection then
		spectateState.characterConnection:Disconnect()
		spectateState.characterConnection = nil
	end
	local function onCharacter(character)
		if not spectateState.active or spectateState.userId ~= player.UserId then return end
		local humanoid = character:WaitForChild("Humanoid", 3)
		if humanoid and spectateState.active and spectateState.userId == player.UserId then
			PlayerData.Camera.CameraSubject = humanoid
		end
	end
	if player.Character then onCharacter(player.Character) end
	spectateState.characterConnection = player.CharacterAdded:Connect(function(character)
		if spectateState.active and spectateState.userId == player.UserId then
			onCharacter(character)
		end
	end)
end

local function startSpectate(player)
	if not player then return end
	spectateState.active = true
	getgenv().spectatePersist.active = true
	spectateState.target = player
	spectateState.userId = player.UserId
	getgenv().spectatePersist.userId = player.UserId
	setSpectateTarget(player)
	maintainCamera()
	startEsp(player)
end

