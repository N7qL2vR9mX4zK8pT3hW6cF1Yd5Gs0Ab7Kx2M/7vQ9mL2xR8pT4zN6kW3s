local Utils = {}

function Utils.create(className, props)
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		instance[key] = value
	end
	return instance
end

function Utils.addCorner(parent, radius)
	return Utils.create("UICorner", {
		Parent = parent,
		CornerRadius = UDim.new(0, radius or Layout.SmallCorner)
	})
end

function Utils.addStroke(parent, color, thickness)
	return Utils.create("UIStroke", {
		Parent = parent,
		Color = color or Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = 0.45
	})
end

function Utils.formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	local days = math.floor(seconds / 86400)
	local hours = math.floor((seconds % 86400) / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	local secs = seconds % 60
	return string.format("%dD / %dH / %dM / %dS", days, hours, minutes, secs)
end

function Utils.formatNumber(value)
	local isNegative = value < 0
	value = math.abs(value)
	local suffixes = {
		{1e18, "Qi"},
		{1e15, "Qa"},
		{1e12, "T"},
		{1e9, "B"},
		{1e6, "M"}
	}
	for _, entry in ipairs(suffixes) do
		local threshold, suffix = entry[1], entry[2]
		if value >= threshold then
			local scaled = value / threshold
			if suffix == "Qi" or suffix == "Qa" then
				return (isNegative and "-" or "") .. string.format("%.2f%s", scaled, suffix)
			else
				return (isNegative and "-" or "") .. string.format("%.1f%s", scaled, suffix)
			end
		end
	end
	return (isNegative and "-" or "") .. string.format("%.0f", value)
end

