		if not mw and getgenv().mn.mo then
			for _, my in ipairs(a.b:GetPlayers()) do
				if my.UserId == getgenv().mn.mo then
					mw = my
					mh.mi = mw
					mh.mj = my.UserId
					break
				end
			end
		end
		if not mw then
			mq()
			return
		end
	end
	mh.mj = mw.UserId
	mh.mi = mw
	getgenv().mn.mo = mw.UserId
	if mh.ml then
		mh.ml:Disconnect()
		mh.ml = nil
	end
	local function mz(na)
		if not mh.mk or mh.mj ~= mw.UserId then return end
		local nb = na:WaitForChild("Humanoid", 3)
		if nb and mh.mk and mh.mj == mw.UserId then
