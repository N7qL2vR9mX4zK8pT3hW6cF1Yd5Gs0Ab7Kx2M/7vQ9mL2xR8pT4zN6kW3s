local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local VirtualUser = game:GetService("VirtualUser")
local TeleportService = game:GetService("TeleportService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local MaterialService = game:GetService("MaterialService")
local SoundService = game:GetService("SoundService")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local LocalPlayer = Players.LocalPlayer
local AntiAfk = false
local MuscleFarm = false
local ProteinEgg = false
local AutoRejoin = false

local function getHumanoidRootPart()
	local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	return character:WaitForChild("HumanoidRootPart")
end

local function teleportAndPressE()
	local rootPart = getHumanoidRootPart()
	rootPart.CFrame = CFrame.new(-8372, 7, 2859)
	task.wait(0.7)
	VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
	task.wait(0.35)
	VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

local function optimizeGame()
	local player = LocalPlayer
	if not player then return end
	local playerGui = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 5)
	local character = player.Character
	local function shouldKeep(instance)
		if not instance then return true end
		if instance == player or instance:IsDescendantOf(player) then return true end
		if playerGui and (instance == playerGui or instance:IsDescendantOf(playerGui)) then return true end
		if character and (instance == character or instance:IsDescendantOf(character)) then return true end
		local name = tostring(instance.Name)
		if name == "rEvents"
			or name == "muscleEvent"
			or name == "OptimizationOverlay" then
			return true
		end
		if instance:IsA("RemoteEvent") or instance:IsA("RemoteFunction") or instance:IsA("BindableEvent") then
			return true
		end
		if instance:IsDescendantOf(ReplicatedStorage) and (name:find("Event") or name:find("Remote") or name == "rEvents") then
			return true
		end
		return false
	end
	local function destroyUnnecessary(container)
		if not container then return end
		local keep = {}
		local function markAncestors(obj)
			local current = obj
			while current and current ~= game do
				keep[current] = true
				current = current.Parent
			end
		end
		for _, descendant in ipairs(container:GetDescendants()) do
			if shouldKeep(descendant) then
				markAncestors(descendant)
			end
		end
		for _, descendant in ipairs(container:GetDescendants()) do
			if not keep[descendant] then
				pcall(function()
					descendant:Destroy()
				end)
			end
		end
	end
	destroyUnnecessary(Lighting)
	pcall(function()
		Lighting.GlobalShadows = false
		Lighting.FogStart = 9e9
		Lighting.FogEnd = 9e9
		Lighting.Brightness = 0
		Lighting.EnvironmentDiffuseScale = 0
		Lighting.EnvironmentSpecularScale = 0
		Lighting.ExposureCompensation = -20
	end)
	destroyUnnecessary(MaterialService)
	for _, sound in ipairs(SoundService:GetDescendants()) do
		pcall(function()
			if sound:IsA("Sound") then
				sound:Stop()
				sound.Volume = 0
			end
		end)
	end
	destroyUnnecessary(SoundService)
	pcall(function() Workspace.Terrain:Clear() end)
	destroyUnnecessary(Workspace)
	task.wait(1)
	destroyUnnecessary(Workspace)
	destroyUnnecessary(ReplicatedStorage)
	destroyUnnecessary(ReplicatedFirst)
	pcall(function() RunService:Set3dRenderingEnabled(false) end)
	local existingOverlay = playerGui and playerGui:FindFirstChild("OptimizationOverlay")
	if existingOverlay then existingOverlay:Destroy() end
	if playerGui then
		local overlayGui = Instance.new("ScreenGui")
		overlayGui.Name = "OptimizationOverlay"
		overlayGui.IgnoreGuiInset = true
		overlayGui.DisplayOrder = 2147483647
		overlayGui.ResetOnSpawn = false
		overlayGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
		overlayGui.Parent = playerGui
		local blackFrame = Instance.new("Frame")
		blackFrame.Size = UDim2.fromScale(1, 1)
		blackFrame.BackgroundColor3 = Color3.new(0, 0, 0)
		blackFrame.BorderSizePixel = 0
		blackFrame.ZIndex = 2147483647
		blackFrame.Parent = overlayGui
	end
end

local function startAntiAfk()
	task.spawn(function()
		while AntiAfk do
			VirtualUser:Button2Down(Vector2.new())
			task.wait(0.08)
			VirtualUser:Button2Up(Vector2.new())
			task.wait(299.92)
		end
	end)
end

local function startMuscleFarm()
	task.spawn(function()
		local connection
		connection = RunService.Heartbeat:Connect(function()
			if not MuscleFarm then
				connection:Disconnect()
				return
			end
			local muscleEvent = LocalPlayer:FindFirstChild("muscleEvent")
			if muscleEvent then
				for _ = 1, 32 do
					pcall(function()
						muscleEvent:FireServer("rep")
					end)
				end
			end
		end)
	end)
end

local function startProteinEgg()
	task.spawn(function()
		local character = LocalPlayer.Character
		local proteinEgg = character and character:FindFirstChild("Protein Egg")
		if not proteinEgg then
			local backpack = LocalPlayer:FindFirstChild("Backpack")
			proteinEgg = backpack and backpack:FindFirstChild("Protein Egg")
		end
		if proteinEgg then
			local muscleEvent = LocalPlayer:FindFirstChild("muscleEvent")
			if muscleEvent then
				muscleEvent:FireServer("proteinEgg", proteinEgg)
			end
		end
	end)
end

local function startAutoRejoin()
	task.spawn(function()
		while AutoRejoin do
			task.wait(1800)
			if AutoRejoin then
				pcall(function()
					TeleportService:Teleport(game.PlaceId, LocalPlayer)
				end)
			end
		end
	end)
end

task.wait(5)
task.wait(0.175)
pcall(teleportAndPressE)
task.wait(0.175)
AntiAfk = true
startAntiAfk()
task.wait(0.175)
ProteinEgg = true
startProteinEgg()
task.wait(0.175)
MuscleFarm = true
startMuscleFarm()
task.wait(1)
pcall(optimizeGame)
AutoRejoin = true
startAutoRejoin()
