function bw.ck(cl)
	cl = math.max(0, math.floor(cl))
	local cm = math.floor(cl / 86400)
	local cn = math.floor((cl % 86400) / 3600)
	local co = math.floor((cl % 3600) / 60)
	local cp = cl % 60
	return string.format("%dD / %dH / %dM / %dS", cm, cn, co, cp)
end

function bw.cq(cr)
	local cs = cr < 0
	cr = math.abs(cr)
	local ct = {
		{1e18, "Qi"},
		{1e15, "Qa"},
		{1e12, "T"},
		{1e9, "B"},
		{1e6, "M"}
	}
	for _, cu in ipairs(ct) do
		local cv, cw = cu[1], cu[2]
		if cr >= cv then
			local cx = cr / cv
			if cw == "Qi" or cw == "Qa" then
				return (cs and "-" or "") .. string.format("%.2f%s", cx, cw)
			else
				return (cs and "-" or "") .. string.format("%.1f%s", cx, cw)
			end
		end
	end
	return (cs and "-" or "") .. string.format("%.0f", cr)
end

