function bu.bv(bw, bx)
	local by = Instance.new(bw)
	for bz, ca in pairs(bx or {}) do
		by[bz] = ca
	end
	return by
end

function bu.cb(cc, cd)
	return bu.bv("UICorner", {
		Parent = cc,
		CornerRadius = UDim.new(0, cd or bl.bn)
	})
end

function bu.ce(cf, cg, ch)
	return bu.bv("UIStroke", {
		Parent = cf,
		Color = cg or s.bf,
		Thickness = ch or 1,
		Transparency = 0.45
	})
end

function bu.ci(cj)
	cj = math.max(0, math.floor(cj))
	local ck = math.floor(cj / 86400)
	local cl = math.floor((cj % 86400) / 3600)
	local cm = math.floor((cj % 3600) / 60)
	local cn = cj % 60
	return string.format("%dD / %dH / %dM / %dS", ck, cl, cm, cn)
end

function bu.co(cp)
	local cq = cp < 0
	cp = math.abs(cp)
	local cr = {
		{1e18, "Qi"},
		{1e15, "Qa"},
		{1e12, "T"},
		{1e9, "B"},
		{1e6, "M"}
	}
	for _, cs in ipairs(cr) do
		local ct, cu = cs[1], cs[2]
		if cp >= ct then
			local cv = cp / ct
			if cu == "Qi" or cu == "Qa" then
				return (cq and "-" or "") .. string.format("%.2f%s", cv, cu)
			else
				return (cq and "-" or "") .. string.format("%.1f%s", cv, cu)
			end
		end
	end
	return (cq and "-" or "") .. string.format("%.0f", cp)
end

